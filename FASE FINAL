                Console.Write("Seleccione una opción: ");

                string opcionInput = Console.ReadLine();

                switch (opcionInput)
                {
                    case "1":
                        OpcionInsertar();
                        break;
                    case "2":
                        OpcionEliminar();
                        break;
                    case "3":
                        tabla.Mostrar();
                        Pausar();
                        break;
