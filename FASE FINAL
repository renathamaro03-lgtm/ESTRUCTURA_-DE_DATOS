                        break;
                }
            } while (!salir);

            Console.WriteLine("\nGracias por utilizar DataCore v4.0. ¡Hasta pronto!");
        }

        private static void OpcionInsertar()
        {
            try
            {
                Console.Write("\nIngrese ID (entero): ");
                if (!int.TryParse(Console.ReadLine(), out int id))
                {
                    Console.WriteLine("[ERROR] El ID debe ser un número entero válido.");
                    Pausar();
                    return;
                }

                Console.Write("Ingrese Nombre: ");
                string nombre = Console.ReadLine() ?? "Sin Nombre";

                Console.Write("Ingrese Valor: ");
                if (!double.TryParse(Console.ReadLine(), out double valor))
                {
                    Console.WriteLine("[ERROR] El valor ingresado no es válido.");
                    Pausar();
                    return;
                }

                tabla.Insertar(new RegistroDatos(id, nombre, valor));
                indiceOrdenado = null; // Invalida el índice desactualizado
                Console.WriteLine("[ÉXITO] Registro insertado correctamente.");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[ERROR INESPERADO] {ex.Message}");
            }
            Pausar();
        }

        private static void OpcionEliminar()
        {
            try
            {
                Console.Write("\nIngrese ID a eliminar: ");
                if (int.TryParse(Console.ReadLine(), out int id))
                {
                    if (tabla.Eliminar(id))
                    {
                        indiceOrdenado = null; // Invalida el índice desactualizado
                        Console.WriteLine("[ÉXITO] Registro eliminado.");
                    }
                    else
                    {
                        Console.WriteLine("[INFO] No se encontró un registro con ese ID.");
                    }
                }
                else
                {
                    Console.WriteLine("[ERROR] ID no válido.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[ERROR] {ex.Message}");
            }
            Pausar();
        }

        private static void OpcionIndexar()
        {
            if (tabla.Cantidad == 0)
            {
                Console.WriteLine("\n[ADVERTENCIA] No hay datos para indexar.");
                Pausar();
                return;
            }

            indiceOrdenado = tabla.ObtenerArreglo();
            BuscadorIndexado.OrdenarArreglo(indiceOrdenado, 0, indiceOrdenado.Length - 1);
            Console.WriteLine($"\n[ÉXITO] Índice construido correctamente con {indiceOrdenado.Length} elementos ordenados por ID.");
            Pausar();
        }

        private static void OpcionBusquedaBinaria()
        {
            if (indiceOrdenado == null)
            {
                Console.WriteLine("\n[ADVERTENCIA] Debe ejecutar primero la Opción 4 (Indexar y Ordenar) antes de buscar.");
                Pausar();
                return;
            }

            Console.Write("\nIngrese el ID a buscar mediante Búsqueda Binaria: ");
            if (int.TryParse(Console.ReadLine(), out int idBuscado))
            {
                var (resultado, comparaciones) = BuscadorIndexado.BuscarRegistroIndexado(indiceOrdenado, idBuscado);

                Console.WriteLine("\n================ RESULTADO DE BÚSQUEDA ================");
                if (resultado != null)
                {
                    Console.WriteLine($" Registro Encontrado : {resultado}");
                }
                else
                {
                    Console.WriteLine($" Estado               : ID {idBuscado} no encontrado.");
                }
                Console.WriteLine($" Comparaciones hechas : {comparaciones}");
                Console.WriteLine(" Eficiencia algorítmica: O(log n)");
                Console.WriteLine("======================================================");
            }
            else
            {
                Console.WriteLine("[ERROR] ID inválido.");
            }
            Pausar();
        }

        private static bool ConfirmarSalida()
        {
            Console.Write("\n¿Está seguro de que desea salir? (S/N): ");
            string resp = Console.ReadLine()?.Trim().ToUpper();
            return resp == "S";
        }

        private static void Pausar()
        {
            Console.WriteLine("\nPresione cualquier tecla para continuar...");
            Console.ReadKey();
        }
    }
